[Unit]
Description=Agent Emacs daemon (geworfen / openclaw backend, socket=server)
Documentation=https://github.com/junghan0611/geworfen
# 죽으면 그대로 둔다 — 자동 재시작 없음(Restart=no).
# openclaw 백엔드이자 핵심 개인 서버라, 데몬이 죽으면 문제가 즉시 드러나야
# 한다(agenda 엔트리 사라짐). 자동 복구로 문제를 숨기지 않는다. 목표는
# 자동 부활이 아니라, 근본을 고쳐 한두 달씩 안 죽는 것.
# 다시 켤 때: systemctl --user start agent-emacs.service (사람/에이전트 수동).
After=default.target

[Service]
Type=notify
# notify: emacs 는 LIBSYSTEMD 로 빌드돼 있어 daemon 준비가 끝나면 sd_notify 를
# 보낸다(확인: system-configuration-features 에 LIBSYSTEMD, 바이너리가
# libsystemd.so.0 링크). simple 이면 프로세스가 뜨자마자 active 로 표시되는데
# 이 데몬은 straight build-* 를 훑느라 기동에 ~7초 걸린다. 그 사이 active 로
# 보이면 geworfen healthcheck 가 아직 없는 소켓을 때린다.
# systemd --user 기본 PATH 는 systemd bin 뿐이라 데몬이 git 등 외부 프로그램을
# 못 찾는다(denote 의 git 연산이 조용히 실패, 로그에 "Searching for program git").
# NixOS 사용자 프로파일 경로를 명시로 준다 (watchdog 의 timeout 부재와 같은 계열).
Environment=PATH=/run/wrappers/bin:/home/junghan/.nix-profile/bin:/etc/profiles/per-user/junghan/bin:/run/current-system/sw/bin
# --init-directory 가 없으면 시작 실패하므로 미리 생성
ExecStartPre=/run/current-system/sw/bin/mkdir -p /tmp/agent-emacs-init
# --fg-daemon: 포그라운드 데몬 → systemd 가 PID 를 직접 추적 (Type=notify)
ExecStart=/run/current-system/sw/bin/emacs --init-directory=/tmp/agent-emacs-init --fg-daemon=server --load /home/junghan/.doom.d/bin/agent-server.el
Restart=no
# agent-server.el 로드가 느릴 수 있어 여유를 둔다
TimeoutStartSec=120

[Install]
WantedBy=default.target
